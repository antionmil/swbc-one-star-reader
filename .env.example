# Neon (free plan: 100 projects, 0.5 GB each, scale-to-zero after 5 min idle
# and that CANNOT be disabled - never let a visitor wait on a cold read path)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Anthropic
ANTHROPIC_API_KEY=

# Protects /api/cron/*. Vercel sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=

# Single-password gate for /admin. Not auth - it is a moderation queue.
ADMIN_PASSWORD=

# Global daily generation ceiling. Past this, serve cache only.
DAILY_GENERATION_CEILING=2000

# Per-IP daily generations.
IP_DAILY_LIMIT=3

# Sponsor slot. Leave blank to render the "this slot is open" placeholder.
SPONSOR_NAME=
SPONSOR_URL=
SPONSOR_TAGLINE=

# Shown in share cards and OG images.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=
